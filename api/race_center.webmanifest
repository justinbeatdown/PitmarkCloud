{
  "name": "Pitmark Race Center",
  "short_name": "Race Center",
  "description": "Your racing command center for drivers, series, tracks, teams, events, standings, schedules and My Racing.",
  "id": "/race-center",
  "start_url": "/race-center?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080b0f",
  "theme_color": "#0b0f14",
  "orientation": "any",
  "categories": [
    "sports",
    "news",
    "social"
  ],
  "icons": [
    {
      "src": "/race-center-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/race-center-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
