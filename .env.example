ENVIRONMENT=production
APP_VERSION=0.18.2
# Desktop/native clients do not need browser CORS. Add only exact web origins if a future browser UI needs them.
CORS_ORIGINS=

# Use long random values. Never ship these in the desktop app.
PITMARK_SIGNING_SECRET=
PITMARK_ADMIN_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://pitmarkcloud.onrender.com/api/discord/oauth/callback
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_SUPPORT_INVITE_URL=

DISCORD_GATEWAY_ENABLED=true
DISCORD_PRESENCE_TEXT=Pitmark Racing Tools
DISCORD_PRESENCE_TYPE=watching
DISCORD_COMMAND_SCOPE=global
# Public bot install: race cards / session / results / account features only.
DISCORD_INSTALL_PERMISSIONS=117760

# Official Pitmark Discord HQ only. Keep the public commands global; HQ commands
# are separately registered only to this guild and privileged infrastructure
# actions additionally require the exact owner user ID.
DISCORD_HQ_GUILD_ID=
DISCORD_OWNER_USER_ID=
DISCORD_HQ_INSTALL_PERMISSIONS=1497097301174

DATABASE_URL=

# Reserved for the next Shopify phase. Do not add these to the desktop app.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Pitmark Autopilot AI composer
PITMARK_AI_PROVIDER=openai
PITMARK_AI_MODEL=gpt-5.6-luna
PITMARK_AI_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
PITMARK_IMAGE_MODEL=gpt-image-2
PITMARK_IMAGE_TIMEOUT_SECONDS=90

# Optional social OAuth app credentials
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_USER_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0
PITMARK_TIMEZONE=America/New_York
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PITMARK_PUBLIC_STORE_URL=https://pitmarkracing.com

AUTOPILOT_SCAN_HOURS=1
SOCIAL_REALTIME_MAX_AGE_HOURS=4
OPPORTUNITY_DISCOVERY_MAX_AGE_HOURS=72
AUTOPILOT_SCAN_MINUTES=15
